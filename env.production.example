# Copy to an untracked file, chmod 600, and generate distinct random values.
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
ELASTIC_PASSWORD=
ES_SERVICE_PASSWORD=
ADMIN_API_KEY=
API_PORT=8001
API_MEMORY_LIMIT_BYTES=2147483648
ES_INDEX_PREFIX=sanctions
SANCTIONS_IMAGE=hybrid-sanctions:local
SANCTIONS_ES_IMAGE=hybrid-sanctions-elasticsearch:local
CORS_ORIGINS=[]
MAX_REQUEST_BYTES=1048576
MAX_UPLOAD_BYTES=27262976
HTTP_MAX_INFLIGHT=4
HTTP_BODY_TIMEOUT_SECONDS=30
HTTP_PROCESSING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_PENDING=16
EMBEDDING_TIMEOUT_SECONDS=30
INGESTION_VERIFY_TIMEOUT_SECONDS=300
ENABLE_VARIANTS=true
VARIANTS_MAX_PENDING=16
VARIANTS_TIMEOUT_SECONDS=30
# Compose accepts only these deployment variables. Application defaults live in code.
# The service is loopback-only; configure your TLS proxy before external access.
